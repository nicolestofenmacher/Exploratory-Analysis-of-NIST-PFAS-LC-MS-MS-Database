    "FROM samples s\n",
    "JOIN norm_sample_classes nsc\n",
    "    ON s.sample_class_id = nsc.id\n",
    "JOIN peaks p\n",
    "    ON s.id = p.sample_id\n",
    "JOIN compound_fragments cf\n",
    "    ON p.id = cf.peak_id\n",
    "JOIN compounds c\n",
    "    ON cf.compound_id = c.id\n",
    "GROUP BY\n",
    "    s.description,\n",
    "    nsc.name\n",
    "ORDER BY\n",
    "    nsc.name;\n",
    "\"\"\")\n",
    "\n",
    "df = pd.DataFrame(\n",
